{
  "name": "lumen-pdf-annotator-mod",
  "version": "1.0.1",
  "private": true,
  "description": "Fork of Lumen PDF Annotator with colour views and sidecar Markdown export.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theshayneb/lumen-pdf-annotator-mod.git"
  },
  "bugs": {
    "url": "https://github.com/theshayneb/lumen-pdf-annotator-mod/issues"
  },
  "homepage": "https://github.com/theshayneb/lumen-pdf-annotator-mod#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:outline": "node --test test/outline-accuracy.test.mjs",
    "lint": "eslint .",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian-plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "1.13.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
